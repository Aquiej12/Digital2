// --- Estado del juego ---
volatile uint8_t contadorJ1 = 0;
volatile uint8_t contadorJ2 = 0;
volatile uint8_t carreraActiva = 0;   // 1 = jugadores pueden presionar
volatile uint8_t juegoTerminado = 0;  // 1 = ya hay ganador
volatile uint8_t ganador = 0;         // 0 = nadie, 1 = J1, 2 = J2
volatile uint8_t banderaInicio = 0;   // 1 = el main debe correr la cuenta regresiva

#define META 4  // LEDs necesarios para ganar

// Anti-rebote
volatile uint32_t lastTickJ1 = 0;
volatile uint32_t lastTickJ2 = 0;
volatile uint32_t lastTickStart = 0;
#define DEBOUNCE_MS 50

// Polaridad del display
#define SEGMENTO_ENCENDIDO 0

